# ─── Database ───────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=costa_resiliente
POSTGRES_USER=costa
POSTGRES_PASSWORD=change_me_in_production

# ─── Redis ────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── MinIO ────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me_in_production
MINIO_BUCKET_RASTERS=rasters
MINIO_BUCKET_MODELS=models
MINIO_USE_SSL=false

# ─── Planetary Computer (Sentinel-1, STAC) ───────────────────────────────
# No key required for public STAC; set if using signed assets
PC_SDK_SUBSCRIPTION_KEY=

# ─── NASA EarthData (IMERG) ───────────────────────────────────────────────
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# ─── ASF HyP3 (optional SAR RTC) ──────────────────────────────────────────
ASF_EARTHDATA_USERNAME=
ASF_EARTHDATA_PASSWORD=

# ─── Bluesky / AT Protocol ────────────────────────────────────────────────
BSKY_HANDLE=
BSKY_APP_PASSWORD=

# ─── Reddit (PRAW) ────────────────────────────────────────────────────────
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=costa-resiliente/0.1 (IEEE Response Quest; contact: your@email.com)

# ─── Telegram ─────────────────────────────────────────────────────────────
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ─── Ollama ───────────────────────────────────────────────────────────────
OLLAMA_HOST=http://ollama:11434
OLLAMA_PRIMARY_MODEL=gemma3:12b-instruct-q4_K_M
OLLAMA_FALLBACK_MODEL=qwen3:30b-a3b-instruct-2507

# ─── FastAPI / App ────────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change_me_in_production
APP_CORS_ORIGINS=http://localhost:3000,http://localhost:8000
LOG_LEVEL=INFO

# ─── Prefect ──────────────────────────────────────────────────────────────
PREFECT_API_URL=http://prefect-server:4200/api

# ─── STAC (pgstac) ────────────────────────────────────────────────────────
STAC_API_URL=http://stac-api:8080

# ─── Lima AOI (bounding box, WGS84) ──────────────────────────────────────
LIMA_BBOX_WEST=-77.2
LIMA_BBOX_SOUTH=-12.5
LIMA_BBOX_EAST=-76.7
LIMA_BBOX_NORTH=-11.7
