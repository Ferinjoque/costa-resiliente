# ─── Database ───────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=costa_resiliente
POSTGRES_USER=costa
POSTGRES_PASSWORD=change_me_in_production

# ─── Redis ────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── MinIO ────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me_in_production
MINIO_BUCKET_RASTERS=rasters
MINIO_BUCKET_MODELS=models
MINIO_USE_SSL=false

# ─── Planetary Computer (Sentinel-1, STAC) ───────────────────────────────
# No key required for public STAC; set if using signed assets
PC_SDK_SUBSCRIPTION_KEY=

# ─── NASA EarthData (IMERG) ───────────────────────────────────────────────
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# ─── ASF HyP3 (optional SAR RTC) ──────────────────────────────────────────
ASF_EARTHDATA_USERNAME=
ASF_EARTHDATA_PASSWORD=

# ─── Bluesky / AT Protocol ────────────────────────────────────────────────
# Jetstream firehose is public — no credentials needed for ingestion.
# Only set these if you want to post to Bluesky (not required).
# BSKY_HANDLE=yourhandle.bsky.social   (handle only, no URL prefix)
# BSKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ─── Reddit ───────────────────────────────────────────────────────────────
# ingest_reddit() task exists in social.py and uses the public Reddit JSON API
# (no OAuth). Disabled in the default flow because API stability varies.
# Re-enable: add ingest_reddit() to the gather() in ingest_social_flow().
# No credentials required — /r/Peru, /r/Lima, /r/Chosica public JSON.

# ─── Telegram ─────────────────────────────────────────────────────────────
# ingest_telegram() task exists in social.py but disabled by default.
# Reads INDECI Peru and COER Lima channels read-only via telethon.
# Disabled: StringSession auth breaks in Docker/CI environments without
# an interactive phone login first. To re-enable:
#   1. Generate string session locally (once, then paste here):
#      python -c "from telethon.sync import TelegramClient; from telethon.sessions import StringSession; c=TelegramClient(StringSession(),API_ID,'API_HASH'); c.start(); print(c.session.save())"
#   2. Add ingest_telegram() to the gather() in ingest_social_flow()
# TELEGRAM_API_ID=           # From https://my.telegram.org/apps (free)
# TELEGRAM_API_HASH=         # Same page
# TELEGRAM_SESSION_STRING=   # Generated string session (long base64 string)

# ─── Ollama ───────────────────────────────────────────────────────────────
# Primary: Gemma 4 E4B (Google, 2025) — downloaded, confirmed working (9.6 GB).
#   Pull: docker exec costa-ollama ollama pull gemma4:e4b
# Fallback: Qwen3 14B — strong Spanish, smaller footprint for low-VRAM setups.
#   Pull: docker exec costa-ollama ollama pull qwen3:14b
# Alternative models (swap via env var — no code changes needed):
#   qwen3:30b-a3b        — larger Qwen3 MoE, best Spanish if VRAM > 16 GB
#   deepseek-r2:14b      — strong reasoning, good for intent classification
#   gemma4:27b           — full Gemma 4 if VRAM > 20 GB
#   qwen3:8b             — if VRAM < 8 GB (quality trade-off)
OLLAMA_HOST=http://ollama:11434
OLLAMA_PRIMARY_MODEL=gemma4:e4b
OLLAMA_FALLBACK_MODEL=qwen3:14b

# ─── FastAPI / App ────────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change_me_in_production
APP_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:8000
LOG_LEVEL=INFO

# ─── Share tokens ─────────────────────────────────────────────────────────
# Random 32+ byte secret for share token signing. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SHARE_TOKEN_SECRET=change_me_in_production
SHARE_TOKEN_TTL_DAYS=30

# ─── Prefect ──────────────────────────────────────────────────────────────
PREFECT_API_URL=http://prefect-server:4200/api

# ─── STAC (pgstac) ────────────────────────────────────────────────────────
STAC_API_URL=http://stac-api:8080

# ─── Lima AOI (bounding box, WGS84) ──────────────────────────────────────
LIMA_BBOX_WEST=-77.2
LIMA_BBOX_SOUTH=-12.5
LIMA_BBOX_EAST=-76.7
LIMA_BBOX_NORTH=-11.7
