# ─── Public domain ────────────────────────────────────────────────────────────
# Domain that Caddy will obtain a TLS cert for.
# Must point to this server's IP before you start (A record in DNS).
# Can also be a bare IP: PUBLIC_DOMAIN=1.2.3.4  (Caddy will serve http only for IPs)
PUBLIC_DOMAIN=costa.yourdomain.com

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=costa_resiliente
POSTGRES_USER=costa
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=CHANGE_ME_STRONG_RANDOM_VALUE

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── MinIO ────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
# Generate with: openssl rand -hex 32
MINIO_SECRET_KEY=CHANGE_ME_STRONG_RANDOM_VALUE
MINIO_BUCKET_RASTERS=rasters
MINIO_BUCKET_MODELS=models
MINIO_USE_SSL=false

# ─── FastAPI / App ────────────────────────────────────────────────────────────
APP_ENV=production
# Generate with: openssl rand -hex 32
APP_SECRET_KEY=CHANGE_ME_STRONG_RANDOM_VALUE
# Caddy handles TLS; frontend + API share the same domain via path routing.
APP_CORS_ORIGINS=https://costa.yourdomain.com
LOG_LEVEL=WARNING

# ─── Ollama / LLM ─────────────────────────────────────────────────────────────
OLLAMA_HOST=http://ollama:11434
#
# VPS RAM guide:
#   8 GB RAM  → OLLAMA_PRIMARY_MODEL=qwen3:8b       (pull: ~5 GB)
#   16 GB RAM → OLLAMA_PRIMARY_MODEL=gemma4:e4b     (pull: 9.6 GB) ← recommended
#   >20 GB    → OLLAMA_PRIMARY_MODEL=gemma4:27b     (full quality)
#
OLLAMA_PRIMARY_MODEL=gemma4:e4b
OLLAMA_FALLBACK_MODEL=qwen3:8b

# ─── Prefect ──────────────────────────────────────────────────────────────────
PREFECT_API_URL=http://prefect-server:4200/api

# ─── STAC ─────────────────────────────────────────────────────────────────────
STAC_API_URL=http://stac-api:8080

# ─── NASA EarthData (IMERG) — REQUIRED for live precipitation data ─────────────
# Register free: https://urs.earthdata.nasa.gov/users/new
# Then approve GES DISC in your EarthData profile applications.
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# ─── Microsoft Planetary Computer — OPTIONAL (Sentinel-1 rate limits) ─────────
# Register free: https://planetarycomputer.microsoft.com/account/request
PC_SDK_SUBSCRIPTION_KEY=

# ─── Reddit — NOT NEEDED ───────────────────────────────────────────────────────
# Public JSON API — no credentials required for read-only ingest.
# ingest_reddit() is in social.py; re-enable by adding it to gather() call.

# ─── Telegram — OPTIONAL ──────────────────────────────────────────────────────
# Reads INDECI Peru + COER Lima public channels read-only via telethon.
# Disabled: needs interactive phone login to generate a session string.
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_SESSION_STRING=

# ─── Lima AOI (bounding box, WGS84) ──────────────────────────────────────────
LIMA_BBOX_WEST=-77.2
LIMA_BBOX_SOUTH=-12.5
LIMA_BBOX_EAST=-76.7
LIMA_BBOX_NORTH=-11.7
